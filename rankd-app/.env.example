# Copy to .env.local and fill in. .env.local is gitignored; this file is not
# (it documents which variables the app needs — never put real secrets here).

# --- Auth.js (Google provider) ---
# Auth.js infers these exact names, so the Google provider needs no explicit
# config. Generate the secret without printing it:
#   echo "AUTH_SECRET=$(openssl rand -base64 33)" >> .env.local
#
# The Google client comes from console.cloud.google.com → APIs & Services →
# Credentials → OAuth client ID (type: Web application). Authorised redirect
# URIs must include, exactly:
#   http://localhost:3000/api/auth/callback/google
#   https://rankd-app-eight.vercel.app/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Database (Postgres) ---
# Dev runs against the local Docker Postgres in docker-compose.yml
# (`docker compose up -d`); the value below matches it and needs no editing.
# Production uses Neon: set DATABASE_URL to the Neon connection string in the
# Vercel environment instead.
#
# Use a standard Postgres driver (postgres.js), NOT the Neon serverless driver,
# so one code path connects to both Docker and Neon.
DATABASE_URL=postgresql://rankd:rankd@localhost:5432/rankd

# --- Feedback (Resend) ---
# The in-app "Get in touch" form in Settings posts to /api/feedback, which sends
# through Resend. With either of the first two unset the endpoint answers 503 and
# the form says it is not configured, rather than pretending to send.
#
#   RESEND_API_KEY  resend.com -> API Keys. Free tier covers 3,000 emails/month.
#   SUPPORT_EMAIL   where reports land. Any address you actually read.
#   SUPPORT_FROM    optional. Resend only accepts a sender on a domain you have
#                   verified, so leave this unset until there is one — the
#                   default uses Resend's shared sender, which needs no DNS.
#                   NOTE: the shared sender can only deliver to the address that
#                   owns the Resend account, so SUPPORT_EMAIL must be that
#                   address until a domain is verified.
RESEND_API_KEY=
SUPPORT_EMAIL=
SUPPORT_FROM=

# --- Profile pictures (Vercel Blob) ---
# The avatar upload in the profile posts to /api/avatar, which stores the file
# in Vercel Blob and hands back a URL. Unset, the endpoint answers 503 and the
# app falls back to the Google account photo, then to the initial — so avatars
# still work signed in, just not custom ones.
#
# There are TWO ways to authenticate and you only need one:
#
#   BLOB_STORE_ID          what connecting a store in the Vercel dashboard sets
#                          (Storage -> Create -> Blob). The SDK pairs it with a
#                          short-lived VERCEL_OIDC_TOKEN that Vercel injects at
#                          runtime. Nothing secret to paste; this is the path
#                          this project actually uses.
#   BLOB_READ_WRITE_TOKEN  the classic long-lived token. Still supported, and
#                          the simpler option outside Vercel.
#
# For LOCAL dev the OIDC token is fetched by `npx vercel env pull` and expires
# after ~12h, so a local upload that suddenly 401s usually just needs another
# pull rather than debugging. Deployed, it is refreshed automatically.
#
# Uploads are gated on sign-in: an upload endpoint with no auth is a free file
# host for the internet. See the header of src/app/api/avatar/route.ts.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# --- TMDB ---
# Server-side key for the /api/film, /api/person, /api/search and /api/stills
# proxies. Without it those routes answer with empty metadata and the app runs
# without artwork.
TMDB_API_KEY=
